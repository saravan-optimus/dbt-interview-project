/// Salesforce CRM semantic model built locally as a proof of concept. 
/// Tables, columns, relationships, and DAX measures generated 
/// programmatically from dbt schema definitions using LLM + Power BI MCP 
/// — without manual Power BI Desktop interaction. In a production 
/// environment this entire workflow can be orchestrated end-to-end: 
/// Airflow → dbt → LLM + MCP → Power BI Service.
model Model
	culture: en-IN
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["dim_accounts","dim_users","fct_opportunities","fct_opportunities_summary"]

ref table dim_accounts
ref table DateTableTemplate_9b39c45e-717d-4813-85f9-8cd5705c2d93
ref table LocalDateTable_122690d8-f4fa-4dac-9c24-2a0ca2c89720
